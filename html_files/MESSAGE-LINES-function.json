{"addedOn":10,"avgRating":["fa fa-star-o","fa fa-star-o","fa fa-star-o","fa fa-star-o","fa fa-star-o"],"breadcrumbsHtml":"<a href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117\">OpenEdge Development: ABL Reference</a>\n<span><i class=\"fa fa-angle-right\"></i>\n</span>\n<a href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/ABL-Syntax-Reference.html\">ABL Syntax Reference</a>\n<span><i class=\"fa fa-angle-right\"></i>\n</span>\n<span class=\"active\">MESSAGE-LINES function</span>\n","class":"manual","created":2879,"dislikeurl":"https://docs-be.progress.com/dislike/310056","html":"<article class=\"hascomments\" data-page=\"bundle:openedge-abl-reference-117/enus/MESSAGE-LINES-function.html\" id=\"bundle:openedge-abl-reference-117/enus/MESSAGE-LINES-function.html\"><main role=\"main\"><article aria-labelledby=\"ariaid-title1\" class=\"dita\" id=\"MESSAGE-LINES-function\" role=\"article\">\n  <h1 class=\"title topictitle1 reference\" id=\"ariaid-title1\">MESSAGE-LINES function</h1>\n  \n  <div class=\"body refbody\">\n    <section class=\"section\">\n      <p class=\"p\">Returns, as an INTEGER value, the number of\nlines in the message area at the bottom of the window.</p>\n      <div class=\"note note note_note\"><span class=\"note__title\">Note:</span> Does not apply to SpeedScript programming.</div>\n    </section>\n    <section class=\"section\" id=\"MESSAGE-LINES-function__syntax_GC18W52696810\"><h2 class=\"title sectiontitle\" id=\"d112442e99\">Syntax</h2>\n      \n      <table class=\"table frame-all\" id=\"MESSAGE-LINES-function__idGDM2MT2672697\"><caption></caption><colgroup><col style=\"width:100%\" /></colgroup><tbody class=\"tbody\">\n            <tr class=\"row rowsep-0\">\n              <td class=\"entry colsep-1 rowsep-1\">\n                <pre class=\"pre codeblock\"><code>MESSAGE-LINES</code></pre>\n              </td>\n            </tr>\n          </tbody></table>\n    </section>\n    <section class=\"section\" id=\"MESSAGE-LINES-function__example_GC18W62696814\"><h2 class=\"title sectiontitle\" id=\"d112442e125\">Example</h2>\n      \n      <p class=\"p\">The\nfollowing example displays a message on each available message line:</p>\n      <p class=\"p\">\n        <strong class=\"ph b\">r-messl.p</strong>\n      </p>\n      <table class=\"table frame-all\" id=\"MESSAGE-LINES-function__idGDM2MU2672701\"><caption></caption><colgroup><col style=\"width:100%\" /></colgroup><tbody class=\"tbody\">\n            <tr class=\"row rowsep-0\">\n              <td class=\"entry colsep-1 rowsep-1\">\n                <pre class=\"pre codeblock\"><code>DEFINE VARIABLE ix AS INTEGER NO-UNDO.\n\nDO ix = 1 TO <strong class=\"ph b\">MESSAGE-LINES:</strong>\n  MESSAGE &quot;This is message line&quot; ix.\nEND.</code></pre>\n              </td>\n            </tr>\n          </tbody></table>\n    </section>\n  </div>\n<nav role=\"navigation\"><div class=\"familylinks\"><div class=\"previouslink\"><strong>Previous topic:</strong> <a class=\"link\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"MESSAGE-DIGEST-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/MESSAGE-DIGEST-function.html\">MESSAGE-DIGEST function</a></div><div class=\"nextlink\"><strong>Next topic:</strong> <a class=\"link\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"METHOD-statement.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/METHOD-statement.html\">METHOD statement</a></div></div></nav><nav class=\"related-links\" role=\"navigation\"></nav></article></main></article>\n","isWatched":false,"labelText":"Product; Product > OpenEdge; Product > OpenEdge > Version 11.7; Format; Format > Documentation","likes":0,"likeurl":"https://docs-be.progress.com/like/310056","myDocsURL":null,"numOfPageViews":0,"numOfRatingsText":"<span>0 Ratings","revised":2879,"showWatch":false,"topicMeta":[["bookowner","oe11docs"],["bookrights","oe11docs"],["bundle","openedge-abl-reference-117"],["data","OEInformationHub/Product"],["data","OEInformationHub/Product/product_openedge"],["data","OEInformationHub/Product/product_openedge/product_openedge_117"],["data","OEInformationHub/format"],["data","OEInformationHub/format/format_documentation"],["organization","oe11docs"]],"topicTitle":"MESSAGE-LINES function","topicurl":"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/MESSAGE-LINES-function.html","type":"Manual"}