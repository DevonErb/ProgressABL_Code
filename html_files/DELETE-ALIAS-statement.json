{"addedOn":10,"avgRating":["fa fa-star-o","fa fa-star-o","fa fa-star-o","fa fa-star-o","fa fa-star-o"],"breadcrumbsHtml":"<a href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117\">OpenEdge Development: ABL Reference</a>\n<span><i class=\"fa fa-angle-right\"></i>\n</span>\n<a href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/ABL-Syntax-Reference.html\">ABL Syntax Reference</a>\n<span><i class=\"fa fa-angle-right\"></i>\n</span>\n<span class=\"active\">DELETE ALIAS statement</span>\n","class":"manual","created":1470,"dislikeurl":"https://docs-be.progress.com/dislike/309302","html":"<article class=\"hascomments\" data-page=\"bundle:openedge-abl-reference-117/enus/DELETE-ALIAS-statement.html\" id=\"bundle:openedge-abl-reference-117/enus/DELETE-ALIAS-statement.html\"><main role=\"main\"><article aria-labelledby=\"ariaid-title1\" class=\"dita\" id=\"DELETE-ALIAS-statement\" role=\"article\">\n  <h1 class=\"title topictitle1 reference\" id=\"ariaid-title1\">DELETE ALIAS statement</h1>\n  \n  <div class=\"body refbody\">\n    <section class=\"section\">\n      <p class=\"p\">Deletes an alias from the alias table.</p>\n    </section>\n    <section class=\"section\" id=\"DELETE-ALIAS-statement__syntax_GC16GT2689077\"><h2 class=\"title sectiontitle\" id=\"d143016e101\">Syntax</h2>\n      \n      <table class=\"table frame-all\" id=\"DELETE-ALIAS-statement__idGDJ2A12668204\"><caption></caption><colgroup><col style=\"width:100%\" /></colgroup><tbody class=\"tbody\">\n            <tr class=\"row rowsep-0\">\n              <td class=\"entry colsep-1 rowsep-1\">\n                <pre class=\"pre codeblock\"><code>DELETE ALIAS <strong class=\"ph b synmeta\">{</strong><var class=\"keyword varname\">alias</var><strong class=\"ph b synmeta\">|</strong> VALUE ( <var class=\"keyword varname\">expression</var> ) <strong class=\"ph b synmeta\">}</strong></code></pre>\n              </td>\n            </tr>\n          </tbody></table>\n      <dl class=\"dl parml\">\n        \n          <dt class=\"dt pt dlterm\">\n            <var class=\"keyword varname\">alias</var>\n          </dt>\n          <dd class=\"dd pd\">An existing alias. It can be an unquoted string or a quoted string.</dd>\n        \n        \n          <dt class=\"dt pt dlterm\">VALUE (<var class=\"keyword varname\">expression</var>)</dt>\n          <dd class=\"dd pd\">A character-string expression that evaluates to an existing alias.</dd>\n        \n      </dl>\n    </section>\n    <section class=\"section\" id=\"DELETE-ALIAS-statement__example_GC16GU2689088\"><h2 class=\"title sectiontitle\" id=\"d143016e166\">Example</h2>\n      \n      <p class=\"p\">This procedure deletes the alias myalias from the alias table:</p>\n      <p class=\"p\">\n        <strong class=\"ph b\">r-dalias.p</strong>\n      </p>\n      <table class=\"table frame-all\" id=\"DELETE-ALIAS-statement__idGDJ2A32668213\"><caption></caption><colgroup><col style=\"width:100%\" /></colgroup><tbody class=\"tbody\">\n            <tr class=\"row rowsep-0\">\n              <td class=\"entry colsep-1 rowsep-1\">\n                <pre class=\"pre codeblock\"><code>DELETE ALIAS myalias.</code></pre>\n              </td>\n            </tr>\n          </tbody></table>\n    </section>\n    <section class=\"section\" id=\"DELETE-ALIAS-statement__notes_GC16GV2689092\"><h2 class=\"title sectiontitle\" id=\"d143016e201\">Notes</h2>\n      \n      <ul class=\"ul\">\n        <li class=\"li\">If a precompiled program requires an alias and you delete that alias, the program will\n          not run.</li>\n        <li class=\"li\">If you try to delete a nonexistent alias, nothing happens.</li>\n      </ul>\n    </section>\n    <section class=\"section\" id=\"DELETE-ALIAS-statement__see-also_GC16GW2689096\"><h2 class=\"title sectiontitle\" id=\"d143016e216\">See also</h2>\n      \n      <p class=\"p\">\n        <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"ALIAS-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/ALIAS-function.html\">ALIAS function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"CONNECT-statement.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/CONNECT-statement.html\">CONNECT statement</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"CONNECTED-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/CONNECTED-function.html\">CONNECTED function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"CREATE-ALIAS-statement.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/CREATE-ALIAS-statement.html\">CREATE ALIAS statement</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"CREATE-CALL-statement.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/CREATE-CALL-statement.html\">CREATE CALL statement</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DATASERVERS-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DATASERVERS-function.html\">DATASERVERS function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DBCODEPAGE-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DBCODEPAGE-function.html\">DBCODEPAGE function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DBCOLLATION-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DBCOLLATION-function.html\">DBCOLLATION function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DBRESTRICTIONS-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DBRESTRICTIONS-function.html\">DBRESTRICTIONS function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DBTYPE-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DBTYPE-function.html\">DBTYPE function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DBVERSION-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DBVERSION-function.html\">DBVERSION function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DISCONNECT-statement.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DISCONNECT-statement.html\">DISCONNECT statement</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"FRAME-DB-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/FRAME-DB-function.html\">FRAME-DB function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"LDBNAME-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/LDBNAME-function.html\">LDBNAME function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"NUM-DBS-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/NUM-DBS-function.html\">NUM-DBS function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"PDBNAME-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/PDBNAME-function.html\">PDBNAME function</a>, <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"SDBNAME-function.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/SDBNAME-function.html\">SDBNAME function</a></p>\n    </section>\n  </div>\n<nav role=\"navigation\"><div class=\"familylinks\"><div class=\"previouslink\"><strong>Previous topic:</strong> <a class=\"link\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DELETE-statement.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DELETE-statement.html\">DELETE statement</a></div><div class=\"nextlink\"><strong>Next topic:</strong> <a class=\"link\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"DELETE-OBJECT-statement.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DELETE-OBJECT-statement.html\">DELETE OBJECT statement</a></div></div></nav><nav class=\"related-links\" role=\"navigation\"></nav></article></main></article>\n","isWatched":false,"labelText":"Product; Product > OpenEdge; Product > OpenEdge > Version 11.7; Format; Format > Documentation","likes":0,"likeurl":"https://docs-be.progress.com/like/309302","myDocsURL":null,"numOfPageViews":0,"numOfRatingsText":"<span>0 Ratings","revised":1470,"showWatch":false,"topicMeta":[["bookowner","oe11docs"],["bookrights","oe11docs"],["bundle","openedge-abl-reference-117"],["data","OEInformationHub/Product"],["data","OEInformationHub/Product/product_openedge"],["data","OEInformationHub/Product/product_openedge/product_openedge_117"],["data","OEInformationHub/format"],["data","OEInformationHub/format/format_documentation"],["organization","oe11docs"]],"topicTitle":"DELETE ALIAS statement","topicurl":"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/DELETE-ALIAS-statement.html","type":"Manual"}