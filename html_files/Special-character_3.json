{"addedOn":10,"avgRating":["fa fa-star-o","fa fa-star-o","fa fa-star-o","fa fa-star-o","fa fa-star-o"],"breadcrumbsHtml":"<a href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117\">OpenEdge Development: ABL Reference</a>\n<span><i class=\"fa fa-angle-right\"></i>\n</span>\n<a href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/ABL-Syntax-Reference.html\">ABL Syntax Reference</a>\n<span><i class=\"fa fa-angle-right\"></i>\n</span>\n<span class=\"active\">&quot; Special character</span>\n","class":"manual","created":2879,"dislikeurl":"https://docs-be.progress.com/dislike/310720","html":"<article class=\"hascomments\" data-page=\"bundle:openedge-abl-reference-117/enus/Special-character_3.html\" id=\"bundle:openedge-abl-reference-117/enus/Special-character_3.html\"><main role=\"main\"><article aria-labelledby=\"ariaid-title1\" class=\"dita\" id=\"Special-character_3\" role=\"article\">\n  <h1 class=\"title topictitle1 reference\" id=\"ariaid-title1\">&quot; Special character</h1>\n  \n  <div class=\"body refbody\">\n    <section class=\"section\">\n      <p class=\"p\">The double quote (&quot;) encloses character constants\nor strings. To use quotes within a quoted character string, you\nmust use two double quotes (&quot;&quot;), which compile to a single double\nquote (&quot;), or you must put a tilde (~) in front of any quotes within\nthe quoted character string. (This does not work when passing parameters\nto an include file.) </p>\n    </section>\n    <section class=\"section\" id=\"Special-character_3__see-also_GC15P2678554\"><h2 class=\"title sectiontitle\" id=\"d106595e103\">See also</h2>\n      \n      <p class=\"p\">\n        <a class=\"xref\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"Character-string-literal.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/Character-string-literal.html#Character-string-literal\">&quot; &quot;Character-string literal</a>\n      </p>\n    </section>\n  </div>\n<nav role=\"navigation\"><div class=\"familylinks\"><div class=\"previouslink\"><strong>Previous topic:</strong> <a class=\"link\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"Special-character.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/Special-character.html\">~ Special character</a></div><div class=\"nextlink\"><strong>Next topic:</strong> <a class=\"link\" data-bundleid=\"openedge-abl-reference-117\" data-navpath=\"Special-character_7.html\" href=\"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/Special-character_7.html\">&#39; Special character</a></div></div></nav><nav class=\"related-links\" role=\"navigation\"></nav></article></main></article>\n","isWatched":false,"labelText":"Product; Product > OpenEdge; Product > OpenEdge > Version 11.7; Format; Format > Documentation","likes":0,"likeurl":"https://docs-be.progress.com/like/310720","myDocsURL":null,"numOfPageViews":0,"numOfRatingsText":"<span>0 Ratings","revised":2879,"showWatch":false,"topicMeta":[["bookowner","oe11docs"],["bookrights","oe11docs"],["bundle","openedge-abl-reference-117"],["data","OEInformationHub/Product"],["data","OEInformationHub/Product/product_openedge"],["data","OEInformationHub/Product/product_openedge/product_openedge_117"],["data","OEInformationHub/format"],["data","OEInformationHub/format/format_documentation"],["organization","oe11docs"]],"topicTitle":"\" Special character","topicurl":"https://docs-be.progress.com/bundle/openedge-abl-reference-117/page/Special-character_3.html","type":"Manual"}